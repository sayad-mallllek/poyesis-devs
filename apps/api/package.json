{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --enable-source-maps --watch-path=dist dist/main.js\"",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/database/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@langchain/core": "1.2.12",
    "@langchain/openai": "1.5.13",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/throttler": "6.7.0",
    "@octokit/rest": "22.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/contracts": "*",
    "argon2": "0.45.1",
    "arktype": "2.2.3",
    "fastify": "5.12.5",
    "langchain": "1.5.12",
    "lru-cache": "11.5.3",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@babel/plugin-syntax-decorators": "8.0.1",
    "@nestjs/testing": "12.1.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
