# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=debug
# Origin of the web app (only the BFF talks to the API, but keep CORS tight).
WEB_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://poyesis:poyesis@localhost:5433/poyesis?schema=public

# ── Security ─────────────────────────────────────────────────────────────
# `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# 32 bytes, base64 encoded: `openssl rand -base64 32`. Encrypts integration tokens.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400

# ── AI (Command Code provider API, OpenAI-compatible) ────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

# ── Seed ─────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@poyesis.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
