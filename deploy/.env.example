# Production environment for the poyesis.dev stack.
# Copy to deploy/.env, fill in the secrets, and never commit it.
#
# Generate secrets with:
#   openssl rand -base64 48   # JWT_ACCESS_SECRET
#   openssl rand -base64 32   # ENCRYPTION_KEY

# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Public origin of the web app (CORS allow-list; the BFF is same-origin).
WEB_ORIGIN=https://poyesis.dev

# ── Database (internal compose network) ──────────────────────────────────
POSTGRES_USER=poyesis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poyesis
DATABASE_URL=postgresql://poyesis:change-me@db:5432/poyesis?schema=public

# ── Security ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# 32 bytes, base64 encoded. Encrypts integration tokens (AES-256-GCM).
ENCRYPTION_KEY=change-me-32-byte-base64-key-0000000000000=

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_DIR=/data/storage
MAX_UPLOAD_BYTES=26214400

# ── AI (Command Code provider API, OpenAI-compatible) ────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

# ── Seed (used by `docker compose ... run --rm api ... seed.js`) ─────────
SEED_ADMIN_EMAIL=admin@poyesis.dev
SEED_ADMIN_PASSWORD=change-me
