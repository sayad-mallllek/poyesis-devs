# Template for deploy/.env (production). Copy it, fill in the blanks, never commit it.
#   openssl rand -base64 48  → JWT_ACCESS_SECRET
#   openssl rand -base64 32  → ENCRYPTION_KEY
#   openssl rand -hex 24     → POSTGRES_PASSWORD (URL-safe: it is embedded in DATABASE_URL)
# Rendered into /opt/poyesis/deploy/.env on every deploy (CI: DEPLOY_ENV secret).
# Container-internal values (NODE_ENV, PORT, STORAGE_DIR, DATABASE_URL) are set
# in docker-compose.prod.yml, not here.

# ── Host ports (bound to 127.0.0.1; Caddy proxies poyesis.dev → WEB_HOST_PORT) ──
WEB_HOST_PORT=4100
API_HOST_PORT=4101

# ── Database (private compose network) ──────────────────────────────────────
# The password is baked into the data volume on first start; changing it here
# later also requires `ALTER USER` inside Postgres.
POSTGRES_USER=poyesis
POSTGRES_PASSWORD=
POSTGRES_DB=poyesis

# ── API ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
WEB_ORIGIN=https://poyesis.dev
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Encrypts stored GitHub/Sentry tokens — rotating it makes them unreadable.
ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=26214400

# ── AI (Command Code provider API, OpenAI-compatible) ───────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=deepseek/deepseek-v4.1-flash

# ── First administrator (deploy/deploy.sh --seed) ───────────────────────────
SEED_ADMIN_EMAIL=admin@poyesis.dev
SEED_ADMIN_PASSWORD=
